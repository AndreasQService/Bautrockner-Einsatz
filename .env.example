# QTool – Environment Example
# --------------------------------------------------
# Kopiere diese Datei nach .env.local und fülle die Werte aus.
# NIEMALS die .env oder .env.local committen!

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google / AI Configuration
VITE_GOOGLE_API_KEY=your_google_api_key_here

# OneDrive / Microsoft Integration
ONEDRIVE_CLIENT_ID=your_onedrive_client_id_here
VITE_ONEDRIVE_REDIRECT_URI=http://localhost:5173
